# Local development placeholders; replace these credentials locally.
POSTGRES_USER=stocklock
POSTGRES_PASSWORD=change-me
POSTGRES_DB=stocklock
POSTGRES_PORT=5432

# Local processes and Alembic connect through the published host port.
STOCKLOCK_DATABASE_URL=postgresql+asyncpg://stocklock:change-me@localhost:5432/stocklock

SERVICE_HOST=0.0.0.0
SERVICE_PORT=8000
SERVICE_RELOAD=false

# Whole seconds. Lifetime and intervals must be positive (maximum 2147483647).
RESERVATION_LIFETIME_SECONDS=900
# Used by the separately launched expiration worker; Compose starts that worker.
EXPIRATION_CLEANUP_INTERVAL_SECONDS=60

# Terminal history retention; 0 keeps that status indefinitely. Compose starts the worker.
RETENTION_CLEANUP_INTERVAL_SECONDS=86400
EXPIRED_RESERVATION_RETENTION_SECONDS=2592000
CANCELLED_RESERVATION_RETENTION_SECONDS=2592000
CONFIRMATION_RETENTION_SECONDS=2592000
# Batch size must be 1..100. Other worker limits must be positive whole integers.
RETENTION_BATCH_SIZE=100
RETENTION_MAX_BATCHES=100
RETENTION_OPERATION_TIMEOUT_SECONDS=30

# Administrative bearer token; empty disables administrative HTTP operations.
# Generate a private value locally; never commit a real token.
ADMIN_API_TOKEN=

# Separate product garbage collection worker; 0 keeps deleted products indefinitely.
# Products with retained reservations are never removed by automatic cleanup.
DELETED_PRODUCT_RETENTION_SECONDS=2592000
PRODUCT_CLEANUP_INTERVAL_SECONDS=86400
PRODUCT_CLEANUP_BATCH_SIZE=100
PRODUCT_CLEANUP_MAX_BATCHES=100
PRODUCT_CLEANUP_OPERATION_TIMEOUT_SECONDS=30
