# Local development placeholders; replace these credentials locally.
POSTGRES_USER=stocklock
POSTGRES_PASSWORD=change-me
POSTGRES_DB=stocklock
POSTGRES_PORT=5432

# Local processes and Alembic connect through the published host port.
STOCKLOCK_DATABASE_URL=postgresql+asyncpg://stocklock:change-me@localhost:5432/stocklock
# Compose processes use the database service hostname. URL-encode credentials.
STOCKLOCK_CONTAINER_DATABASE_URL=postgresql+asyncpg://stocklock:change-me@postgres:5432/stocklock

SERVICE_HOST=0.0.0.0
SERVICE_PORT=8000
SERVICE_RELOAD=false

# Whole seconds. Lifetime and intervals must be positive (maximum 2147483647).
RESERVATION_LIFETIME_SECONDS=900
# Used by the separately launched expiration worker; Compose starts that worker.
EXPIRATION_CLEANUP_INTERVAL_SECONDS=60

# Retention settings are reserved for future workers and never delete records yet.
RETENTION_CLEANUP_INTERVAL_SECONDS=86400
EXPIRED_RESERVATION_RETENTION_SECONDS=0
CANCELLED_RESERVATION_RETENTION_SECONDS=0
CONFIRMATION_RETENTION_SECONDS=0
